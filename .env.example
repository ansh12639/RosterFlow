# Copy to .env and fill in. Never commit the real .env.
FLASK_APP=run.py
SECRET_KEY=change-me-to-a-long-random-string

# MySQL 8 / MariaDB 10.6+ (PyMySQL driver)
DATABASE_URL=mysql+pymysql://roster_user:your-password@localhost:3306/rosterflow?charset=utf8mb4
# Hosted MySQL that requires TLS (Aiven, TiDB Cloud…): path to a CA bundle
# MYSQL_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Create tables + load the demo dataset automatically on first start (empty DB only)
AUTO_SEED=0
# Show the "Reset demo data" button (keep 1 on the public demo, 0 in real use)
ALLOW_DEMO_RESET=1

# Scheduling policy
MAX_SHIFT_SPAN_HOURS=9
MAX_COVERS_PER_DAY=1

# Optional: plain-English conflict explanations by Claude. Without a key a
# deterministic rule-based explanation is shown instead.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
